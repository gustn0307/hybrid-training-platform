# 로컬 .env로 복사한 뒤 비밀번호를 직접 설정한다. .env는 커밋하지 않는다.
POSTGRES_DB=ai_love_workout
POSTGRES_USER=ai_love_workout
# 기본 비밀번호를 제공하지 않으며 Compose와 Spring Boot 실행에 실제 주입이 필요하다.
POSTGRES_PASSWORD=
# Base64로 인코딩한 최소 32바이트 난수. 실제 서명키를 이 예제에 넣지 않는다.
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=5432
BACKEND_PORT=8080
AI_PORT=8000
FRONTEND_PORT=5173
# 호스트 개발용 주소다. Compose는 각 컨테이너에서 접근할 내부 서비스 주소로 대체한다.
AI_SERVICE_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8080
